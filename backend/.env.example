# 知栈 ZhiStack 后端环境变量（复制为 .env 使用）
# 在 backend 目录下：cp .env.example .env

APP_ENV=development
SECRET_KEY=change-me-to-a-long-random-string   # 生产必须改

# 开发默认 SQLite，无需装数据库
DB_DSN=sqlite+aiosqlite:///./data/zhistack.db
# 生产：PostgreSQL + pgvector
# DB_DSN=postgresql+asyncpg://zhistack:zhistack@localhost:5432/zhistack

STORAGE_ROOT=./data/storage
CORS_ORIGINS=http://localhost:5173

ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# 模型（M4 起用）——推荐硅基流动 SiliconFlow（免费、OpenAI 兼容）
# 注册 cloud.siliconflow.cn → 控制台「API 密钥」新建一个，填到 LLM_API_KEY
LLM_DEFAULT_PROVIDER=siliconflow
LLM_BASE_URL=https://api.siliconflow.cn/v1
LLM_MODEL=Qwen/Qwen2.5-7B-Instruct   # 中文强、永久免费；也可换 GLM-4-9B-Chat / DeepSeek-R1-Distill-Qwen-7B
LLM_API_KEY=

# 备选：智谱 GLM（GLM-4-Flash 永久免费）
# LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# LLM_MODEL=glm-4-flash

MAX_UPLOAD_MB=500
AI_MONTHLY_BUDGET_USD=20
