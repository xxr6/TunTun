# ===== 囤囤 TUNTUN 环境变量模板 =====
# 复制为 .env 后按需修改。后端在 backend/.env，根 .env 供 docker-compose 使用。

# ── 应用 ──
APP_ENV=development          # development | production
SECRET_KEY=change-me-to-a-long-random-string   # JWT 签名密钥，生产必须改
DB_DSN=sqlite+aiosqlite:///./data/zhistack.db
# Docker Compose 的 PostgreSQL 密码（部署时替换）
DB_PASSWORD=change-me-before-deploy
# 生产 / 正式：改用 PostgreSQL + pgvector
# DB_DSN=postgresql+asyncpg://zhistack:zhistack@localhost:5432/zhistack
STORAGE_ROOT=./data/storage
CORS_ORIGINS=http://localhost:5173

# ── JWT ──
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# ── 模型（云端为主，M4 起用）── 推荐硅基流动 SiliconFlow（免费、OpenAI 兼容）
LLM_DEFAULT_PROVIDER=siliconflow
LLM_BASE_URL=https://api.siliconflow.cn/v1
LLM_MODEL=Qwen/Qwen2.5-7B-Instruct   # 中文强、永久免费
LLM_API_KEY=
# 备选：智谱 GLM（GLM-4-Flash 永久免费）
# LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# LLM_MODEL=glm-4-flash
EMBEDDING_PROVIDER=dashscope
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_DIM=1536

# ── 限制 ──
MAX_UPLOAD_MB=500
AI_MONTHLY_BUDGET_USD=20
